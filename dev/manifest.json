{
  "manifest_version": 3,
  "name": "Side Sheet Notes",
  "version": "1.2.0",
  "description": "【統合・移行案内】Spreadsheet形式のサイドバーメモ（後継版Penta Note Proへの移行をお願いします）",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/app-icon-16.png",
    "32": "icons/app-icon-32.png",
    "48": "icons/app-icon-48.png",
    "128": "icons/app-icon-128.png"
  },
  "action": {
    "default_title": "Side Sheet Notesを開く",
    "default_icon": {
      "16": "icons/app-icon-16.png",
      "32": "icons/app-icon-32.png",
      "48": "icons/app-icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}